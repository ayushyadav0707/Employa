datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String         @id @default(cuid())
  employeeId     String         @unique
  name           String
  email          String         @unique
  password       String
  role           String         @default("Employee")
  phone          String?
  address        String?
  profilePicture String?
  jobTitle       String?
  department     String?
  designation    String?
  avatar         String?
  salary         Float?         @default(50000)
  panNo          String?
  uanNo          String?
  documents      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  payrolls       Payroll[]
  leaveBalance   LeaveBalance?
  payrollConfig  PayrollConfig?
}

model Attendance {
  id                   String   @id @default(cuid())
  userId               String?
  employeeId           String?
  date                 String
  checkIn              String?
  checkOut             String?
  totalHours           Float    @default(0)
  status               String   @default("Present")
  location             String?  @default("HQ - Floor 3")
  remarks              String?
  breakDurationMinutes Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id             String   @id @default(cuid())
  userId         String?
  employeeId     String?
  type           String
  startDate      String
  endDate        String
  allocationDays Int      @default(0)
  reason         String?
  remarks        String?
  status         String   @default("Pending")
  comments       String?
  adminComment   String?
  attachmentUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveBalance {
  id          Int    @id @default(autoincrement())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidTimeOff Float  @default(24)
  sickTimeOff Float  @default(7)
}

model PayrollConfig {
  id                   Int    @id @default(autoincrement())
  userId               String @unique
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  basicSalaryPercent   Float  @default(50)
  hraPercent           Float  @default(50)
  standardAllowPercent Float  @default(16.67)
  perfBonusPercent     Float  @default(8.33)
  travelAllowPercent   Float  @default(8.333)
  pfPercent            Float  @default(12)
  profTax              Float  @default(200)
}

model Payroll {
  id         String   @id @default(cuid())
  userId     String?
  employeeId String?
  month      String
  baseSalary Float
  bonus      Float    @default(0)
  deductions Float    @default(0)
  netSalary  Float
  status     String   @default("Paid")
  payslipUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}
