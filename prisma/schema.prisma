generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  employeeId     String?   @unique @default(cuid()) // From main
  loginId        String    @unique // Format: OIJODO20260001 (From Auth)
  email          String    @unique
  emailVerified  DateTime?
  verifyToken    String?   @unique
  password       String
  role           String    @default("EMPLOYEE")
  
  // Profile Information
  companyName    String?   // Mostly relevant for the HR Admin registration
  companyLogo    String?   // Matches the wireframe logo upload
  name           String
  phone          String?
  address        String?
  profilePicture String?
  jobTitle       String?
  department     String?
  designation    String?   // From main
  avatar         String?   // From main
  salary         Float?    @default(50000) // From main
  panNo          String?   // From main
  uanNo          String?   // Missing from main
  bankAccount    String?   // From main
  status         String    @default("PENDING")
  adminNotes     String?       
  
  // Auth logic flags
  isFirstLogin   Boolean   @default(true) // Forces password reset on first login

  // Relations
  payrollConfig  PayrollConfig?
  leaveRequests  LeaveRequest[] @relation("UserLeaveRequests")
  leaveBalance   LeaveBalance?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PayrollConfig {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  salary    Int
  taxPct    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveRequest {
  id             String   @id @default(cuid())
  user           User     @relation("UserLeaveRequests", fields: [userId], references: [id])
  userId         String
  type           String
  startDate      DateTime
  endDate        DateTime
  allocationDays Int
  reason         String
  status         String
  attachmentUrl  String?
  adminComment   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LeaveBalance {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  paidTimeOff Int      @default(24)
  sickTimeOff Int      @default(7)
  updatedAt   DateTime @updatedAt
}
